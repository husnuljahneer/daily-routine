{
  "expo": {
    "name": "Daily Routine",
    "slug": "daily-routine",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.dailyroutine"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.personal.dailyroutine"
    }
  }
}
